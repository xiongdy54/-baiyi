{
  "name": "incremental-reading-dev",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && node scripts/postbuild-pdf-compat.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@likecoin/epub-ts": "^0.7.2",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@mozilla/readability": "^0.6.0",
    "@types/markdown-it": "^14.2.0",
    "dompurify": "^3.4.14",
    "fsrs-rs-nodejs": "^0.9.1",
    "github-slugger": "^2.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "mammoth": "^1.12.3",
    "markdown-it": "^14.3.1",
    "micromark-extension-mark": "^1.0.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "turndown": "^7.2.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
